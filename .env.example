# ── Supabase ──────────────────────────────────────────────
# Your Supabase project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Your Supabase publishable key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — NEVER expose to the client. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Revalidation ─────────────────────────────────────────
# Shared secret your Supabase webhook sends to /api/revalidate
REVALIDATION_SECRET=

# ── Site ─────────────────────────────────────────────────
# Production URL (used for sitemap, canonical URLs, OG images)
SITE_URL=https://your-domain.vercel.app

# ── Auth ─────────────────────────────────────────────────
# Your Supabase user UUID — used for the admin auth gate
OWNER_UUID=
